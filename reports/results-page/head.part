<title>PDE-RSI Benchmark Results</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:ital,wght@0,500;0,600;1,400&display=swap">
<style>
/* Layout: a lab notebook — results first (summary, then per-PDE grids), reference second (equations, splits, settings). */
:root {
  --bg: #f7f8fa; --surface: #ffffff; --ink: #18202b; --muted: #5b6676; --rule: #dde2ea;
  --accent: #1d5d8c; --accent-soft: #e4eef6; --heat: #1d6f8c; --good: #2f7d4f;
  --serif: "IBM Plex Serif", Georgia, "Times New Roman", serif;
  --sans: "IBM Plex Sans", "Helvetica Neue", Arial, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #11161d; --surface: #182029; --ink: #e6ebf1; --muted: #98a3b2; --rule: #2a3542;
  --accent: #7fb6e0; --accent-soft: #1d2c3a; --heat: #3d9cc4; --good: #6cc18f; color-scheme: dark } }
:root[data-theme="dark"] {
  --bg: #11161d; --surface: #182029; --ink: #e6ebf1; --muted: #98a3b2; --rule: #2a3542;
  --accent: #7fb6e0; --accent-soft: #1d2c3a; --heat: #3d9cc4; --good: #6cc18f; color-scheme: dark }
* { box-sizing: border-box }
body { background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 15px; line-height: 1.55;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 0 64px }
main { max-width: 1180px; margin: 0 auto }
header.top { padding-block: 40px 20px; border-bottom: 1px solid var(--rule); margin-bottom: 28px }
.eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted) }
h1 { font-family: var(--serif); font-weight: 600; font-size: clamp(28px, 4vw, 40px); line-height: 1.15; margin: 6px 0 12px; text-wrap: balance }
h2 { font-family: var(--serif); font-weight: 600; font-size: 24px; margin: 44px 0 6px; text-wrap: balance }
h3 { font-size: 16px; font-weight: 600; margin: 28px 0 8px }
p, li { max-width: 72ch } p { margin: 0 0 10px } ul { padding-left: 20px; margin: 0 0 10px }
.lede { color: var(--muted); font-size: 16px }
nav.toc { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; margin-top: 14px }
nav.toc a { color: var(--accent); text-decoration: none } nav.toc a:hover, nav.toc a:focus-visible { text-decoration: underline }
a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px }
.defs { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin: 16px 0 6px }
.def { background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 12px 14px; min-width: 0 }
.def b { display: block; font-size: 14px; margin-bottom: 4px } .def span { color: var(--muted); font-size: 13.5px }
.scroll { overflow-x: auto; margin: 10px 0 6px; border: 1px solid var(--rule); border-radius: 6px; background: var(--surface) }
table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums }
caption { caption-side: top; text-align: left; font-family: var(--mono); font-size: 12px; color: var(--muted); padding: 10px 12px 4px; letter-spacing: .02em }
th, td { padding: 6px 10px; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top }
thead th { font-size: 12.5px; font-weight: 600; color: var(--muted); background: var(--surface); white-space: nowrap }
thead th .m { display: block; font-family: var(--mono); font-size: 11px; font-weight: 400; color: var(--muted) }
tbody th { font-weight: 500; white-space: nowrap; font-size: 14px }
tbody tr:last-child > * { border-bottom: 0 }
table.summary td { min-width: 128px }
.score { display: flex; align-items: baseline; gap: 6px; position: relative }
.score b { font-size: 18px; font-weight: 600 }
.bar { position: absolute; left: 0; bottom: -4px; height: 3px; width: calc(var(--p) * 100%); background: var(--accent); border-radius: 2px }
.sub { font-family: var(--mono); font-size: 11.5px; color: var(--muted); margin-top: 8px; white-space: nowrap }
.of { color: var(--muted); font-size: 11px }
table.grid td.c { text-align: center; white-space: nowrap; font-family: var(--mono); font-size: 13px;
  background: color-mix(in oklab, var(--heat) calc(var(--p) * 42%), var(--surface)) }
table.grid td.c.best { font-weight: 600; box-shadow: inset 0 0 0 2px var(--accent) }
table.grid td.tot { text-align: center; font-family: var(--mono); font-weight: 600 }
table.grid tr.total th { font-weight: 600 } table.grid tr.total > * { border-top: 2px solid var(--rule) }
td.na { color: var(--muted); text-align: center } td.l2 { font-family: var(--mono); font-size: 12.5px; color: var(--muted) }
table.ref td { font-size: 13.5px } table.ref td code, .eq { font-family: var(--mono); font-size: 13px }
.eq { background: var(--accent-soft); padding: 1px 6px; border-radius: 4px; white-space: nowrap }
.note { font-size: 13.5px; color: var(--muted) }
.legend { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; font-size: 12.5px; color: var(--muted); margin: 6px 0 2px }
.swatch { display: inline-block; width: 14px; height: 14px; border-radius: 3px; vertical-align: -2px; margin-right: 5px;
  background: color-mix(in oklab, var(--heat) calc(var(--p) * 42%), var(--surface)); border: 1px solid var(--rule) }
.swatch.best { box-shadow: inset 0 0 0 2px var(--accent) }
.findings { display: grid; gap: 10px; margin: 14px 0 } .findings li { margin-bottom: 4px }
.two { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px } .two > * { min-width: 0 }
section { scroll-margin-top: 12px }
@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto } }
</style>